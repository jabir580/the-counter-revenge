    <!-- Application Logic -->
    <script>
        // CONFIGURATION: CHANGE THIS NUMBER TO UPDATE ALL WHATSAPP BUTTONS
        const WHATSAPP_NUMBER = "+8801595441703";
        const YOUTUBE_URL = "https://youtube.com/@thecounterrevenge";
        
        let comboUnlocked = false;

        document.addEventListener('DOMContentLoaded', () => {
            // Allow click outside modal to close it
            document.getElementById('combo-modal').addEventListener('click', (e) => {
                if(e.target === e.currentTarget) closeComboModal();
            });
        });

        /**
         * Ordering & WhatsApp Logic
         */
        function orderWhatsApp(msg) {
            const number = WHATSAPP_NUMBER.replace(/[^0-9]/g, ''); // strip non-numeric
            const url = `https://api.whatsapp.com/send?phone=${number}&text=${encodeURIComponent(msg)}`;
            window.open(url, '_blank');
        }

        /**
         * Combo Unlock Flow
         */
        function openComboModal() {
            document.getElementById('combo-modal').classList.remove('hidden');
            // small delay for transition
            setTimeout(() => {
                document.getElementById('combo-modal').classList.remove('opacity-0');
                document.getElementById('combo-sheet').classList.add('open');
            }, 10);
            
            // reset flow if not unlocked yet
            if(!comboUnlocked) {
                document.getElementById('combo-step-1').classList.remove('hidden');
                document.getElementById('combo-step-2').classList.add('hidden');
                document.getElementById('combo-step-3').classList.add('hidden');
                document.getElementById('unlock-progress').style.width = '0%';
                document.getElementById('unlock-countdown').innerText = '8';
            } else {
                document.getElementById('combo-step-1').classList.add('hidden');
                document.getElementById('combo-step-3').classList.remove('hidden');
                document.getElementById('combo-step-3').classList.add('flex');
            }
        }

        function closeComboModal() {
            document.getElementById('combo-sheet').classList.remove('open');
            document.getElementById('combo-modal').classList.add('opacity-0');
            setTimeout(() => {
                document.getElementById('combo-modal').classList.add('hidden');
            }, 300);
        }

        let timerInterval;
        function startUnlockFlow() {
            window.open(YOUTUBE_URL, '_blank');
            document.getElementById('combo-step-1').classList.add('hidden');
            document.getElementById('combo-step-2').classList.remove('hidden');
            document.getElementById('combo-step-2').classList.add('flex');
            
            let count = 8;
            document.getElementById('unlock-countdown').innerText = count;
            
            // start animation
            setTimeout(() => {
                document.getElementById('unlock-progress').style.width = '100%';
                document.getElementById('unlock-progress').style.transitionDuration = '8s';
            }, 50);

            timerInterval = setInterval(() => {
                count--;
                document.getElementById('unlock-countdown').innerText = count;
                if(count <= 0) {
                    clearInterval(timerInterval);
                    comboUnlocked = true;
                    // Switch to success
                    document.getElementById('combo-step-2').classList.remove('flex');
                    document.getElementById('combo-step-2').classList.add('hidden');
                    document.getElementById('combo-step-3').classList.remove('hidden');
                    document.getElementById('combo-step-3').classList.add('flex');
                    
                    // Update Main Page UI dynamically
                    document.getElementById('ui-combo-price').innerText = '450৳';
                    document.getElementById('ui-combo-save').innerText = 'SAVE 55৳';
                }
            }, 1000);
        }

        function orderUnlockedCombo() {
            let msg = comboUnlocked 
                ? `Hello The Counter Revenge, I want to order the Suarez + Casillas Combo Pack for 450 BDT [Special Discount: YouTube Subscribed ✅]`
                : `Hello The Counter Revenge, I want to order the Suarez + Casillas Combo Pack for 460 BDT.`;
            orderWhatsApp(msg);
        }

        /**
         * Utilities
         */
        function copyText(elementId) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text).then(() => {
                showToast(`Copied ${text}`);
            });
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            t.style.transform = 'translateY(0)';
            setTimeout(() => {
                t.style.transform = 'translateY(-150%)';
            }, 3000);
        }

        function toggleFaq(idx) {
            const ans = document.getElementById(`faq-ans-${idx}`);
            const icon = document.getElementById(`faq-icon-${idx}`);
            if(ans.classList.contains('hidden')) {
                ans.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                ans.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }
    </script>
